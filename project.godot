; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Find The Door"
run/main_scene="res://menus/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://sprites/DALL·E 2024-02-11 16.17.40 - Modify the logo for BRUTE STUDIOS to combine specific elements from the initial design and recent feedback. Retain the original design's core concept .png"
config/icon="res://sprites/game_icon.png"
boot_splash/minimum_display_time=1000

[autoload]

GameVariables="*res://globals/game_variables.gd"
GameManager="*res://globals/GameManager.tscn"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="scribble_2d"

[editor]

movie_writer/mjpeg_quality=0.15
movie_writer/movie_file="/Users/jonck/scribble_2d/video.avi"
movie_writer/disable_vsync=true
movie_writer/fps=30
import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg", "res://addons/better-terrain/plugin.cfg", "res://addons/camera_2d_plus/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/script-tabs/plugin.cfg")


; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="scribble_2d"
run/main_scene="res://menus/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameVariables="*res://globals/game_variables.gd"
GameManager="*res://globals/GameManager.tscn"
MainMenuEffects="*res://menus/MainMenuEffects.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=2
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="scribble_2d"

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg", "res://addons/camera_2d_plus/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/script-tabs/plugin.cfg")

